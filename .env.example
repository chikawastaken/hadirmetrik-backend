APP_NAME=HadirMetrik
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=hadirmetrik
DB_USERNAME=hadirmetrik
DB_PASSWORD=change-me

# Docker Compose — dipakai oleh `docker compose up -d db` (atau `make db`).
# DB_PORT di atas harus sama dengan POSTGRES_PORT agar Laravel bisa terhubung.
POSTGRES_DB=hadirmetrik
POSTGRES_USER=hadirmetrik
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433
ADMINER_PORT=8080

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sanctum / API
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1
SANCTUM_TOKEN_PREFIX=
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@hadirmetrik.local"
MAIL_FROM_NAME="${APP_NAME}"

# Seeder credentials (development only). Deliberately blank: `php artisan db:seed`
# refuses to run until these are set, so no password is committed to the repo.
SEED_ADMIN_PASSWORD=
SEED_EMPLOYEE_PASSWORD=
SEED_EMPLOYEE_NUMBER=EMP-0001
SEED_EMPLOYEE_EMAIL=employee@hadirmetrik.local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
